# Copia este archivo a .env.local y completa los valores.
# Si un valor contiene el carácter #, ponlo entre comillas ("..."),
# porque si no se interpreta como comentario y el valor queda cortado.

# Cadena de conexión de Neon (rama "dev" para trabajar en tu PC).
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require

# Clave para firmar las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# URL donde corre la app: http://localhost:3000 en tu PC, y la URL pública en Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Solo los usa `npm run db:setup` para sembrar el administrador inicial.
# No los pongas en Vercel.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD="una-clave-segura-de-al-menos-8-caracteres"

# Notificaciones push (opcional). Genera las claves con `npm run vapid` y copia
# las tres líneas aquí y en Vercel. Sin ellas, las novedades solo se ven dentro de la app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
